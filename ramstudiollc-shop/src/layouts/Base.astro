---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { usingSampleCatalog } from '../lib/catalog';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** 'dark' when the page opens with a dark hero (white header). */
  headerTone?: 'dark' | 'light';
}
const { title, description = site.description, image, noindex = false, headerTone = 'light' } = Astro.props;
const fullTitle = title.includes('RAM Studio') ? title : `${title} · RAM Studio`;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const ogImage = new URL(image ?? site.logo.icon, site.domain).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={site.logo.icon} type="image/png" />
    <meta name="theme-color" content="#07080f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shopName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {site.checkout === 'overlay' && <script is:inline src="https://gumroad.com/js/gumroad.js"></script>}
    <slot name="head" />
  </head>
  <body>
    {usingSampleCatalog && (
      <div class="sample-bar">Sample catalogue — run <code>npm run import:store</code> to load the real Gumroad products.</div>
    )}
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // 1. Reveal on scroll: [data-reveal] fades and rises 40px into place once it enters the screen.
      //    Children of [data-stagger] get an increasing delay.
      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        [...group.children].forEach((child, i) => {
          const el = child as HTMLElement;
          if (!el.hasAttribute('data-reveal')) el.setAttribute('data-reveal', '');
          el.style.setProperty('--i', String(i % 8));
        });
      });
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // 1b. Count-up: [data-countup="68"] counts from 0 when it appears.
      const counters = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          const target = parseFloat(el.dataset.countup || '0');
          const decimals = (el.dataset.countup || '').split('.')[1]?.length ?? 0;
          const t0 = performance.now();
          const tick = (t: number) => {
            const k = Math.min(1, (t - t0) / 1400);
            const eased = 1 - Math.pow(1 - k, 4);
            el.textContent = (target * eased).toFixed(decimals);
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          counters.unobserve(el);
        }
      }, { threshold: 0.4 });
      document.querySelectorAll('[data-countup]').forEach((el) => counters.observe(el));

      // 2. Scroll-linked motion: [data-speed="0.2"] moves at a different pace from the page.
      const movers = [...document.querySelectorAll<HTMLElement>('[data-speed]')];
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (movers.length && !reduce) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          for (const el of movers) {
            const r = el.parentElement!.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) continue;
            const progress = (vh - r.top) / (vh + r.height); // 0 → 1 while the block crosses the screen
            const speed = parseFloat(el.dataset.speed || '0');
            const axis = el.dataset.axis === 'x' ? 'X' : 'Y';
            el.style.transform = `translate${axis}(${(progress - 0.5) * speed * 100}%)`;
          }
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        }, { passive: true });
        update();
      }
    </script>
  </body>
</html>

<style>
  .sample-bar {
    background: #fff8d6;
    color: #574700;
    font-size: 13px;
    text-align: center;
    padding: 8px var(--gutter);
  }
</style>
