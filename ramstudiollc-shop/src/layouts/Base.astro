---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { usingSampleCatalog } from '../lib/catalog';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const { title, description = site.description, image, noindex = false } = Astro.props;
const fullTitle = title.includes('RAM Studio') ? title : `${title} · RAM Studio`;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const ogImage = image ? new URL(image, site.domain).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shopName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    {site.checkout === 'overlay' && <script is:inline src="https://gumroad.com/js/gumroad.js"></script>}
    <slot name="head" />
  </head>
  <body>
    {usingSampleCatalog && (
      <div class="sample-bar">
        <div class="wrap">
          Sample catalogue — these are demo products. Run <code>npm run sync:gumroad</code> to load your real Gumroad products.
        </div>
      </div>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .sample-bar {
    background: #fff6d6;
    border-bottom: 1px solid #ecd889;
    color: #5a4a00;
    font-size: 0.82rem;
    padding: 8px 0;
    text-align: center;
  }
  .sample-bar code {
    font-family: var(--mono);
    background: rgb(0 0 0 / 0.06);
    padding: 1px 5px;
    border-radius: 4px;
  }
</style>
