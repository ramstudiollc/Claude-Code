---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import CategoryRail from '../components/home/CategoryRail.astro';
import Values from '../components/home/Values.astro';
import ProductSection from '../components/home/ProductSection.astro';
import FreebiesCarousel from '../components/home/FreebiesCarousel.astro';
import GalleryWall from '../components/home/GalleryWall.astro';
import BuyFlow from '../components/BuyFlow.astro';
import Proof from '../components/home/Proof.astro';
import PassBand from '../components/home/PassBand.astro';
import AgencyBand from '../components/AgencyBand.astro';
import FaqList from '../components/FaqList.astro';
import { home } from '../data/content';
import { products } from '../lib/catalog';

// Featured first, then newest; six cards fill two rows of three.
const latest = [...products.filter((p) => p.featured), ...products.filter((p) => !p.featured)].slice(0, 6);
---

<Base title={home.seo.title} description={home.seo.description} headerTone="dark">
  <Hero />
  <CategoryRail />
  <ProductSection eyebrow={home.latest.eyebrow} title={home.latest.title} sub={home.latest.sub} cta={home.latest.cta} items={latest} />
  <Values />
  <FreebiesCarousel />
  <GalleryWall />
  <BuyFlow />
  <Proof />
  <PassBand />
  <AgencyBand />
  <FaqList />
</Base>
