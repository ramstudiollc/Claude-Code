---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base
  title="Mockup License — What You Can Do · RAM Studio"
  description="The RAM Studio mockup licence in plain English: use the files in personal and commercial client work; do not resell, share or redistribute the source files."
>
  <section class="section">
    <div class="wrap">
      {!site.licenseReviewed && (
        <p class="notice">
          Draft licence. Have it reviewed, then set <code>licenseReviewed: true</code> in <code>src/config/site.ts</code> to hide this note.
        </p>
      )}
      <article class="prose">
        <h1>Mockup license</h1>
        <p>
          <strong>Short version:</strong> use our mockups to present your own or your clients' work, including commercial projects.
          Do not resell or give away the mockup files themselves.
        </p>

        <h2>You can</h2>
        <ul>
          <li>Use a mockup in unlimited personal and commercial projects.</li>
          <li>Show the rendered images in portfolios, client presentations, websites, ads and social media.</li>
          <li>Use the rendered images in product listings for physical products you sell.</li>
          <li>Edit the file: change colours, backgrounds, shadows and artwork.</li>
        </ul>

        <h2>You cannot</h2>
        <ul>
          <li>Resell, share, sublicense or give away the PSD or any source file, edited or not.</li>
          <li>Upload the files, or templates built from them, to marketplaces, mockup generators or asset libraries.</li>
          <li>Claim the mockup itself as your own design.</li>
        </ul>

        <h2>Free mockups</h2>
        <p>Free mockups follow the same licence. Credit is welcome but not required.</p>

        <h2>All-Access Pass</h2>
        <p>
          Files downloaded with the All-Access Pass use this same licence. If your membership ends, work you already made with
          those files can stay published.
        </p>

        <h2>Questions</h2>
        <p>
          Email <a href={`mailto:${site.agency.email}`}>{site.agency.email}</a> before you start if your use is not covered here.
        </p>
      </article>
    </div>
  </section>
</Base>

<style>
  .notice {
    margin-bottom: 28px;
  }
  .prose h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
</style>
