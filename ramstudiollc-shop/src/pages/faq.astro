---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const faqs = [
  {
    q: 'Why does checkout open on Gumroad?',
    a: 'Gumroad is our payment and delivery partner. It handles the card or PayPal payment, the receipt, local sales tax and the download link. This site shows the catalogue; Gumroad completes the order.',
  },
  {
    q: 'Where do I find my files after I pay?',
    a: 'Gumroad emails you a download link straight after payment. The same files stay in your Gumroad Library, so you can download them again from any device by logging in with the email you used at checkout.',
  },
  {
    q: 'Which software do I need?',
    a: 'Adobe Photoshop. Each product page lists the file format. Mockups use smart objects: double-click the layer, paste your design, save, and the scene updates.',
  },
  {
    q: 'Can I use the mockups for client work?',
    a: 'Yes. Personal and commercial client work is allowed. You may not resell or share the mockup source files. The full terms are on the license page.',
  },
  {
    q: 'Do free mockups have the same quality?',
    a: 'Yes. Free mockups are complete, layered files from the same studio. They are a fair way to test our files before you buy.',
  },
  {
    q: 'Can you make a custom mockup for my product?',
    a: `Yes. RAM Studio designs custom mockups, packaging and 3D renders. Custom e-commerce mockups start from $100. Contact ${site.agency.email} or start a project on ramstudiollc.com.`,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="FAQ — Buying & Using RAM Studio Mockups"
  description="Answers about buying RAM Studio mockups: why checkout runs on Gumroad, where to find your downloads, software needed, licensing and custom mockup requests."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <section class="section">
    <div class="wrap narrow">
      <h1>Questions and answers</h1>
      <div class="list">
        {faqs.map((f) => (
          <details>
            <summary><h3>{f.q}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="more">
        Still stuck? Email <a href={`mailto:${site.agency.email}`}>{site.agency.email}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 820px;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 28px;
  }
  .list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
    padding: 18px 0;
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1;
  }
  details[open] summary::after {
    content: '–';
  }
  summary h3 {
    font-size: 1.08rem;
  }
  details p {
    margin-top: 12px;
    color: var(--ink-2);
    max-width: 66ch;
  }
  .more {
    margin-top: 28px;
  }
  .more a {
    color: var(--accent);
    font-weight: 700;
  }
</style>
