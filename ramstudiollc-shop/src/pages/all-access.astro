---
import Base from '../layouts/Base.astro';
import { site, isSet } from '../config/site';
import { products } from '../lib/catalog';

const yearlyReady = isSet(site.allAccess.url);
const lifetimeReady = isSet(site.allAccess.lifetimeUrl);
const included = products.filter((p) => p.allAccess).length;

const benefits = [
  `Every mockup in the shop — ${included} files today`,
  'Every new release while your membership is active',
  'The same commercial licence as single purchases',
  'Download from your Gumroad Library at any time',
];
---

<Base
  title="All-Access Pass — Every RAM Studio Mockup"
  description="One Gumroad membership unlocks every RAM Studio PSD mockup plus every new release while it is active. Commercial licence included."
>
  <section class="section page">
    <div class="wrap">
      <header class="head">
        <p class="eyebrow">All-Access Pass</p>
        <h1>Every mockup, one membership</h1>
        <p class="lede">
          Pay once on Gumroad and download the full RAM Studio library, plus everything released while your pass is active.
        </p>
      </header>

      <div class="plans">
        <article class="plan">
          <h2>Yearly pass</h2>
          {isSet(site.allAccess.yearlyPrice) && <p class="price">{site.allAccess.yearlyPrice}</p>}
          <ul>
            {benefits.map((b) => <li>{b}</li>)}
          </ul>
          {yearlyReady ? (
            <a class="btn btn-accent btn-block" href={site.allAccess.url} rel="noopener">Join on Gumroad</a>
          ) : (
            <span class="btn btn-block" aria-disabled="true">Launching soon</span>
          )}
        </article>

        {lifetimeReady && (
          <article class="plan dark">
            <h2>Lifetime pass</h2>
            {isSet(site.allAccess.lifetimePrice) && <p class="price">{site.allAccess.lifetimePrice}</p>}
            <ul>
              <li>Everything in the yearly pass</li>
              <li>Pay once, no renewals</li>
              <li>All future releases included</li>
            </ul>
            <a class="btn btn-accent btn-block" href={site.allAccess.lifetimeUrl} rel="noopener">Get lifetime access</a>
          </article>
        )}
      </div>

      <div class="qa">
        <h2>Questions about the pass</h2>
        <h3>How do I get the files?</h3>
        <p>After checkout, Gumroad emails you a link. Every file in the pass is also listed in your Gumroad Library.</p>
        <h3>Can I cancel?</h3>
        <p>Yes. Cancel from your Gumroad account. Files you already downloaded stay yours under the licence.</p>
        <h3>Do I need the pass to use free mockups?</h3>
        <p>No. <a href="/freebies/">Free mockups</a> are free for everyone.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(32px, 5vw, 56px);
  }
  .head {
    max-width: 60ch;
    margin-bottom: 40px;
  }
  .head h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
  }
  .lede {
    margin-top: 14px;
    font-size: 1.12rem;
    color: var(--ink-2);
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 400px));
    gap: 20px;
  }
  .plan {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: 28px;
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .plan.dark {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .plan h2 {
    font-size: 1.3rem;
  }
  .price {
    font-size: 2.2rem;
    font-weight: 800;
  }
  .plan ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .plan li::before {
    content: '✓';
    color: var(--accent);
    font-weight: 800;
    margin-right: 10px;
  }
  .qa {
    margin-top: 64px;
    max-width: 64ch;
  }
  .qa h2 {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }
  .qa h3 {
    margin-top: 22px;
  }
  .qa p {
    margin-top: 6px;
    color: var(--ink-2);
  }
  .qa a {
    color: var(--accent);
    font-weight: 700;
  }
</style>
