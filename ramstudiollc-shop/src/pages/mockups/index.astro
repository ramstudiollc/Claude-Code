---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProductBrowser from '../../components/ProductBrowser.astro';
import { library } from '../../data/content';
import { products } from '../../lib/catalog';
---

<Base title={library.seo.title} description={library.seo.description}>
  <PageHero eyebrow={library.eyebrow} title={library.title} sub={library.sub} />
  <section class="section-tight">
    <div class="wrap">
      <ProductBrowser items={products} />
    </div>
  </section>
</Base>
