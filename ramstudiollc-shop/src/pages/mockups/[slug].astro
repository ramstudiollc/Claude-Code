---
import Base from '../../layouts/Base.astro';
import BuyButton from '../../components/BuyButton.astro';
import Icon from '../../components/Icon.astro';
import MockupArt from '../../components/MockupArt.astro';
import ProductCard from '../../components/ProductCard.astro';
import { site, isSet } from '../../config/site';
import { product as copy } from '../../data/content';
import { categoryBySlug } from '../../data/categories';
import { products, related, bundleItems, priceLabel, isFree, type Product } from '../../lib/catalog';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product: p } = Astro.props as { product: Product };
const cat = categoryBySlug(p.category);
const free = isFree(p);
const inside = p.type === 'bundle' ? bundleItems(p) : [];
const more = related(p, 3);
const summary = p.summary || `${p.title} — ${cat?.name ?? 'mockup'} PSD.`;
const specs = [...(p.formats.length ? [{ label: 'Format', value: p.formats.join(', ') }] : []), ...(p.specs ?? []), { label: 'Preview scenes', value: String(p.images.length) }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.title,
  description: summary,
  category: cat?.name,
  brand: { '@type': 'Brand', name: site.legalName },
  ...(p.images.length ? { image: p.images.map((i) => new URL(i, site.domain).href) } : {}),
  ...(p.rating && p.rating.count ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: p.rating.value, reviewCount: p.rating.count } } : {}),
  ...(isSet(p.gumroadUrl) ? { offers: { '@type': 'Offer', url: p.gumroadUrl, price: p.price.toFixed(2), priceCurrency: p.currency || 'USD', availability: 'https://schema.org/InStock' } } : {}),
};
---

<Base title={`${p.title}${free ? '' : ` — ${priceLabel(p)}`}`} description={`${summary} ${free ? 'Free download' : priceLabel(p)} on Gumroad.`} image={p.images[0]} noindex={p.sample}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb" data-reveal>
      <a href="/mockups/">Mockups</a><Icon name="chevron" size={14} />
      {cat && <><a href={`/category/${cat.slug}/`}>{cat.name}</a><Icon name="chevron" size={14} /></>}
      <span aria-current="page">{p.title}</span>
    </nav>

    <div class="layout">
      <div class="gallery" data-gallery>
        {p.images.length ? (
          <>
            <figure class="main" data-reveal="zoom">
              <img src={p.images[0]} alt={`${p.title}: preview 1`} width="1600" height="1067" data-main />
              <span class="counter"><span data-index>1</span> / {p.images.length}</span>
            </figure>
            {p.images.length > 1 && (
              <div class="thumbs" data-stagger>
                {p.images.map((src, i) => (
                  <button type="button" class="thumb" data-thumb={src} data-n={i + 1} aria-label={`Show preview ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                    <img src={src} alt="" loading="lazy" width="320" height="213" />
                  </button>
                ))}
              </div>
            )}
          </>
        ) : (
          <figure class="main"><MockupArt kind={p.art ?? 'box'} label={p.title} /></figure>
        )}

        <section class="block" data-reveal>
          <h2 class="block-title">{copy.sections.gallery}</h2>
          <div class="stack">
            {p.images.slice(1).map((src, i) => <img src={src} alt={`${p.title}: preview ${i + 2}`} loading="lazy" width="1600" height="1067" data-reveal />)}
          </div>
        </section>

        {p.description && (
          <section class="block" data-reveal>
            <h2 class="block-title">{copy.sections.about}</h2>
            <div class="prose" set:html={p.description} />
          </section>
        )}
      </div>

      <aside class="buy">
        <div class="buy-in panel" data-reveal>
          <div class="tags">
            {cat && <a class="badge" href={`/category/${cat.slug}/`}>{cat.short}</a>}
            {free && <span class="badge badge-blue">Free</span>}
            {inside.length > 0 && <span class="badge badge-dark">Bundle · {inside.length}</span>}
          </div>
          <h1 class="title">{p.title}</h1>
          {p.rating && p.rating.count > 0 && (
            <p class="rating"><span class="stars">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}</span> {p.rating.value.toFixed(1)} · {p.rating.count} Gumroad {p.rating.count === 1 ? 'review' : 'reviews'}</p>
          )}
          <p class="summary muted">{summary}</p>
          <div class="price-row">
            <span class="price">{priceLabel(p)}</span>
            {p.payWhatYouWant && <span class="small muted">{free ? 'pay what you want' : 'or more'}</span>}
          </div>
          <BuyButton product={p} block />
          {free && <p class="note small"><Icon name="gift" size={16} /> {copy.freeNote}</p>}
          <p class="secure small muted"><Icon name="check" size={16} /> {copy.secure}</p>

          {p.features && p.features.length > 0 && (
            <div class="group">
              <h2 class="group-title">{copy.sections.get}</h2>
              <ul class="ticks">{p.features.map((f) => <li><Icon name="check" size={16} /> {f}</li>)}</ul>
            </div>
          )}

          <div class="group">
            <h2 class="group-title">{copy.sections.specs}</h2>
            <dl class="specs">
              {specs.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
            </dl>
          </div>

          {p.useCases && p.useCases.length > 0 && (
            <div class="group">
              <h2 class="group-title">{copy.sections.perfect}</h2>
              <ul class="uses">{p.useCases.map((u) => <li>{u}</li>)}</ul>
            </div>
          )}

          <p class="lic small muted"><Icon name="license" size={16} /> {copy.license} <a href="/license/" class="link">License</a></p>
        </div>
      </aside>
    </div>

    {inside.length > 0 && (
      <section class="section-tight">
        <h2 class="h2 sec-title" data-reveal>Inside this bundle</h2>
        <div class="grid-cards" data-stagger>{inside.map((x) => <ProductCard product={x} />)}</div>
      </section>
    )}

    {more.length > 0 && (
      <section class="section-tight">
        <div class="head">
          <h2 class="h2" data-reveal>{copy.sections.related}</h2>
          {cat && <a class="link" href={`/category/${cat.slug}/`} data-reveal>All {cat.name.toLowerCase()} →</a>}
        </div>
        <div class="grid-cards" data-stagger>{more.map((x) => <ProductCard product={x} />)}</div>
      </section>
    )}
  </div>
</Base>

<script>
  const main = document.querySelector<HTMLImageElement>('[data-main]');
  const idx = document.querySelector('[data-index]');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
  thumbs.forEach((b) =>
    b.addEventListener('click', () => {
      if (!main) return;
      main.animate([{ opacity: 0.4 }, { opacity: 1 }], { duration: 350, easing: 'ease-out' });
      main.src = b.dataset.thumb!;
      if (idx) idx.textContent = b.dataset.n!;
      thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
    }),
  );
</script>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 40px 0 28px;
    font-size: 14px;
    color: var(--ink-500);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--blue-500);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(340px, 0.85fr);
    gap: 40px;
    align-items: start;
  }
  .main {
    position: relative;
    margin: 0;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--surface-2);
    aspect-ratio: 3 / 2;
    box-shadow: var(--shadow-panel);
  }
  .main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .counter {
    position: absolute;
    right: 16px;
    bottom: 16px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: rgb(3 4 28 / 0.55);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }
  .thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 10px;
    margin-top: 14px;
  }
  .thumb {
    padding: 0;
    border: 2px solid transparent;
    border-radius: 14px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    aspect-ratio: 3 / 2;
    transition: border-color var(--t-fast), transform var(--t-fast) var(--ease);
  }
  .thumb:hover {
    transform: translateY(-3px);
  }
  .thumb[aria-pressed='true'] {
    border-color: var(--blue-500);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .block {
    margin-top: 56px;
  }
  .block-title,
  .group-title {
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-500);
    margin-bottom: 16px;
  }
  .stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .stack img:first-child {
    grid-column: 1 / -1;
  }
  .stack img {
    width: 100%;
    border-radius: var(--r-lg);
  }
  .buy {
    position: sticky;
    top: 92px;
  }
  .buy-in {
    padding: 28px;
    display: grid;
    gap: 16px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags a {
    text-decoration: none;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 43px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .rating {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .stars {
    display: inline-flex;
    color: #ffb400;
  }
  .summary {
    font-size: 16px;
  }
  .price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .price {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .note,
  .secure,
  .lic {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .note {
    padding: 12px 14px;
    border-radius: var(--r-md);
    background: #e7f0ff;
    color: var(--blue-600);
  }
  .note :global(svg),
  .secure :global(svg),
  .lic :global(svg) {
    flex: none;
    margin-top: 3px;
  }
  .group {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 15px;
  }
  .ticks li {
    display: flex;
    gap: 8px;
  }
  .ticks :global(svg) {
    color: var(--blue-500);
    flex: none;
    margin-top: 3px;
  }
  .specs {
    margin: 0;
    display: grid;
  }
  .specs div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    font-size: 15px;
    border-bottom: 1px dashed var(--line);
  }
  .specs div:last-child {
    border-bottom: 0;
  }
  .specs dt {
    color: var(--ink-500);
  }
  .specs dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  .uses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .uses li {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--page);
    font-size: 14px;
  }
  .sec-title {
    margin-bottom: 32px;
  }
  @media (max-width: 889px) {
    .stack {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 1199px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .buy {
      position: static;
      order: -1;
    }
  }
</style>
