---
// Simple 24px line icons drawn for this shop. Usage: <Icon name="box" />
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;

const paths: Record<string, string> = {
  arrow: 'M5 12h14M13 6l6 6-6 6',
  'arrow-up': 'M7 17 17 7M9 7h8v8',
  'arrow-left': 'M19 12H5M11 6l-6 6 6 6',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4',
  menu: 'M4 8h16M4 16h16',
  close: 'M6 6l12 12M18 6 6 18',
  chevron: 'M6 9l6 6 6-6',
  box: 'M4 8l8-4 8 4v8l-8 4-8-4zM4 8l8 4 8-4M12 12v8',
  cards: 'M3 7h13v10H3zM8 4h13v10',
  shirt: 'M8 4l4 2 4-2 5 4-3 3-2-1v10H8V10l-2 1-3-3z',
  device: 'M3 6h18v11H3zM8 21h8M12 17v4',
  cup: 'M6 8h12l-1.5 12h-9zM5 5h14v3H5zM9 3h6',
  flag: 'M5 21V4M5 4h11l-2 4 2 4H5',
  spark: 'M12 3v5M12 16v5M3 12h5M16 12h5M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3',
  layers: 'M12 3 3 8l9 5 9-5zM3 13l9 5 9-5M3 17l9 5 9-5',
  size: 'M4 4h6M4 4v6M20 20h-6M20 20v-6M4 4l7 7M20 20l-7-7',
  license: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h5',
  card: 'M3 6h18v12H3zM3 10h18M7 15h4',
  download: 'M12 4v11M7 10l5 5 5-5M5 20h14',
  cart: 'M4 5h2l2 11h10l2-8H7M10 20h.01M17 20h.01',
  gift: 'M4 10h16v10H4zM3 7h18v3H3zM12 7v13M12 7c-2-4-6-3-5 0M12 7c2-4 6-3 5 0',
  file: 'M6 3h9l4 4v14H6zM14 3v5h5',
  star: 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z',
  check: 'M5 12l4 4 10-10',
  mail: 'M3 6h18v12H3zM3 7l9 6 9-6',
  grid: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  image: 'M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 6M15 9h.01',
};
const d = paths[name] ?? paths.spark;
const filled = name === 'star';
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={d}></path></svg
>
