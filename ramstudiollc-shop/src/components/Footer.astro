---
import { site, isSet } from '../config/site';
import { categories } from '../data/categories';
const socials = site.social.filter((s) => isSet(s.url));
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap cols">
    <div class="brand">
      <a href="/" class="logo">ramstudiollc<span>.shop</span></a>
      <p>Mockups made by {site.agency.name}. Browse here — checkout, payment and downloads are handled by Gumroad.</p>
      <p class="contact"><a href={`mailto:${site.agency.email}`}>{site.agency.email}</a></p>
    </div>

    <nav aria-label="Categories">
      <h3>Categories</h3>
      <ul>
        {categories.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Shop">
      <h3>Shop</h3>
      <ul>
        <li><a href="/mockups/">All mockups</a></li>
        <li><a href="/bundles/">Bundles</a></li>
        <li><a href="/freebies/">Freebies</a></li>
        <li><a href="/all-access/">All-Access Pass</a></li>
        {isSet(site.gumroadStore) && <li><a href={site.gumroadStore} rel="noopener">Our Gumroad store</a></li>}
      </ul>
    </nav>

    <nav aria-label="Help">
      <h3>Help</h3>
      <ul>
        <li><a href="/license/">License</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/about/">About RAM Studio</a></li>
        <li><a href={site.agency.url} rel="noopener">Custom design work</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap base">
    <p>© {year} {site.agency.name}. All mockups are original work of RAM Studio.</p>
    {socials.length > 0 && (
      <ul class="social">
        {socials.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
      </ul>
    )}
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: #cfccc4;
    margin-top: 40px;
    padding-top: 64px;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
  }
  .logo {
    color: #fff;
    font-weight: 800;
    font-size: 1.2rem;
    text-decoration: none;
  }
  .logo span {
    color: var(--accent);
  }
  .brand p {
    margin-top: 14px;
    max-width: 36ch;
    font-size: 0.92rem;
  }
  .contact a {
    color: #fff;
  }
  h3 {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 0.92rem;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover,
  .social a:hover {
    color: #fff;
  }
  .base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid #2c2c2a;
    margin-top: 48px;
    padding-block: 24px;
    font-size: 0.82rem;
  }
  .social {
    display: flex;
    gap: 18px;
  }
  .social a {
    text-decoration: none;
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
