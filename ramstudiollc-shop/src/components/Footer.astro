---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { site, isSet } from '../config/site';
import { activeCategories, stats } from '../lib/catalog';
const year = new Date().getFullYear();
---

<footer class="footer dark-band grain on-dark">
  <div class="wrap">
    <div class="top">
      <div class="brand" data-reveal>
        <a href="/" aria-label="Home"><img src={site.logo.light} alt={site.legalName} width="180" height="33" /></a>
        <p class="muted">
          {stats.products} Photoshop mockups by a packaging design studio. Browse here — checkout and downloads run on Gumroad.
        </p>
        <a class="mail" href={`mailto:${site.agency.email}`}><Icon name="mail" size={18} /> {site.agency.email}</a>
      </div>

      <nav aria-label="Categories" data-reveal style="--i:1">
        <h2 class="col-title">Mockups</h2>
        <ul>
          {activeCategories.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>)}
          <li><a href="/freebies/">Free mockups</a></li>
          <li><a href="/gallery/">Gallery</a></li>
        </ul>
      </nav>

      <nav aria-label="Help" data-reveal style="--i:2">
        <h2 class="col-title">Help</h2>
        <ul>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/license/">License</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href={site.agency.url} rel="noopener">Custom design work</a></li>
        </ul>
      </nav>

      {isSet(site.newsletterUrl) && (
        <div class="news" data-reveal style="--i:3">
          <h2 class="col-title">New releases by email</h2>
          <p class="muted small">Free mockups and new sets, sent by Gumroad when they go live. Unsubscribe any time.</p>
          <Button href={site.newsletterUrl} variant="light" size="sm">Subscribe on Gumroad</Button>
        </div>
      )}
    </div>

    <div class="stores" data-reveal>
      <span class="small muted">Also on</span>
      {site.marketplaces.filter((m) => isSet(m.url)).map((m) => <a href={m.url} rel="noopener" class="chip-dark">{m.label}</a>)}
      {isSet(site.gumroadStore) && <a href={site.gumroadStore} rel="noopener" class="chip-dark">Gumroad store</a>}
    </div>

    <div class="base">
      <p>© {year} {site.legalName}. All mockups are original work of RAM Studio.</p>
      <ul class="social">
        {site.social.filter((s) => isSet(s.url)).map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-radius: 40px 40px 0 0;
    margin-top: var(--section);
    padding-top: clamp(56px, 7vw, 96px);
  }
  .top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
    gap: 40px;
  }
  .brand img {
    height: 33px;
    width: auto;
  }
  .brand p {
    margin-top: 20px;
    max-width: 34ch;
    font-size: 15px;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    text-decoration: none;
    font-weight: 600;
  }
  .mail:hover {
    color: #8db8ff;
  }
  .col-title {
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8db8ff;
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  nav a,
  .social a {
    text-decoration: none;
    color: #d4d9ea;
    font-size: 15px;
    transition: color var(--t-fast);
  }
  nav a:hover,
  .social a:hover {
    color: #fff;
  }
  .news p {
    margin-bottom: 18px;
  }
  .stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 56px;
  }
  .chip-dark {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-dark);
    background: var(--glass-dark);
    font-size: 14px;
    text-decoration: none;
    transition: background var(--t-fast);
  }
  .chip-dark:hover {
    background: rgb(255 255 255 / 0.16);
  }
  .base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 32px;
    padding-block: 28px;
    border-top: 1px solid var(--line-dark);
    font-size: 13px;
    color: #9aa1bb;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  @media (max-width: 1199px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 889px) {
    .top {
      grid-template-columns: 1fr;
    }
    .footer {
      border-radius: 28px 28px 0 0;
    }
  }
</style>
