---
import Icon from './Icon.astro';
import MockupArt from './MockupArt.astro';
import { categoryBySlug } from '../data/categories';
import { priceLabel, isNew, isFree, type Product } from '../lib/catalog';

interface Props {
  product: Product;
  size?: 'md' | 'lg';
  eager?: boolean;
}
const { product: p, size = 'md', eager = false } = Astro.props;
const cat = categoryBySlug(p.category);
const free = isFree(p);
const [cover, second] = p.images;
const date = p.releasedAt ? new Date(p.releasedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---

<article
  class:list={['pcard', `pcard-${size}`]}
  data-card
  data-category={p.category}
  data-price={p.price}
  data-free={free ? '1' : '0'}
  data-type={p.type}
  data-date={p.releasedAt ?? ''}
  data-title={p.title.toLowerCase()}
  data-search={`${p.title} ${p.tags.join(' ')} ${cat?.name ?? ''} ${p.useCases?.join(' ') ?? ''}`.toLowerCase()}
>
  <a href={`/mockups/${p.slug}/`} class="media" aria-label={p.title}>
    {cover ? (
      <>
        <img src={cover} alt={`${p.title} preview`} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1600" height="1067" class="img-a" />
        {second && <img src={second} alt="" loading="lazy" decoding="async" width="1600" height="1067" class="img-b" />}
      </>
    ) : (
      <MockupArt kind={p.art ?? 'box'} />
    )}
    <span class="badges">
      {free && <span class="badge badge-free">Free</span>}
      {p.type === 'bundle' && <span class="badge badge-ink">Bundle</span>}
      {isNew(p, 30) && <span class="badge badge-glass">New</span>}
    </span>
    <span class="scenes badge badge-glass"><Icon name="image" size={12} /> {p.images.length} scenes</span>
    <span class="go" aria-hidden="true"><Icon name="arrow-up" size={18} /></span>
  </a>
  <div class="meta">
    <div class="row">
      <h3 class="title"><a href={`/mockups/${p.slug}/`}>{p.title}</a></h3>
      <span class="price">{priceLabel(p)}</span>
    </div>
    <div class="row sub">
      <span class="tags">
        <span class="badge">{cat?.short}</span>
        {date && <span class="date mono">{date}</span>}
      </span>
      {p.rating && p.rating.count > 0 && (
        <span class="rating" aria-label={`Rated ${p.rating.value} out of 5 by ${p.rating.count} buyers`}>
          <Icon name="star" size={13} /> {p.rating.value.toFixed(1)}
        </span>
      )}
    </div>
  </div>
</article>

<style>
  .pcard {
    padding: 8px;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-md);
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .pcard:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
  }
  .media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(180deg, #fff, var(--surface-2));
  }
  .pcard-lg .media {
    aspect-ratio: 16 / 11.5;
  }
  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out), opacity 0.6s var(--ease);
  }
  .img-b {
    opacity: 0;
  }
  .pcard:hover .img-a {
    transform: scale(1.06);
  }
  .pcard:hover .img-b {
    opacity: 1;
    transform: scale(1.06);
  }
  .badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 6px;
    z-index: 1;
  }
  .scenes {
    position: absolute;
    left: 12px;
    bottom: 12px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--t) var(--ease), transform var(--t) var(--ease);
  }
  .go {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    box-shadow: var(--gloss), 0 10px 20px -8px rgb(11 13 23 / 0.6);
    opacity: 0;
    transform: translateY(8px) scale(0.8);
    transition: opacity var(--t) var(--ease), transform var(--t) var(--spring);
  }
  .pcard:hover .go,
  .pcard:hover .scenes {
    opacity: 1;
    transform: none;
  }
  .meta {
    padding: 16px 10px 8px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
  }
  .title {
    font-size: 16.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .pcard-lg .title {
    font-size: 18px;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    color: var(--blue);
  }
  .price {
    font-weight: 500;
    font-size: 16px;
    color: var(--ink);
    white-space: nowrap;
  }
  .sub {
    margin-top: 10px;
    align-items: center;
  }
  .tags {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .date {
    font-size: 12px;
    color: var(--muted);
  }
  .rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .rating :global(svg) {
    color: var(--sun);
  }
</style>
