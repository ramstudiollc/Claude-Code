---
import MockupArt from './MockupArt.astro';
import { categoryBySlug } from '../data/categories';
import { priceLabel, isNew, isFree, type Product } from '../lib/catalog';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const cat = categoryBySlug(p.category);
const free = isFree(p);
const cover = p.images[0];
---

<article
  class="card"
  data-card
  data-category={p.category}
  data-formats={p.formats.join(',').toLowerCase()}
  data-price={p.price}
  data-free={free ? '1' : '0'}
  data-type={p.type}
  data-date={p.releasedAt ?? ''}
  data-search={`${p.title} ${p.tags.join(' ')} ${cat?.name ?? ''}`.toLowerCase()}
>
  <a href={`/mockups/${p.slug}/`} class="thumb">
    {cover ? (
      <img src={cover} alt={`${p.title} preview`} loading="lazy" decoding="async" width="600" height="450" />
    ) : (
      <MockupArt kind={p.art ?? 'box'} />
    )}
    <span class="badges">
      {p.type === 'bundle' && <span class="pill pill-ink">Bundle</span>}
      {free && <span class="pill pill-accent">Free</span>}
      {isNew(p) && !free && <span class="pill">New</span>}
      {p.sample && <span class="pill">Sample</span>}
    </span>
  </a>
  <div class="meta">
    <div class="row">
      <h3><a href={`/mockups/${p.slug}/`}>{p.title}</a></h3>
      <span class="price">{priceLabel(p)}</span>
    </div>
    <p class="sub">
      {cat?.name}
      {p.formats.length > 0 && <> · {p.formats.join(' / ')}</>}
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .thumb:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 6px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .price {
    font-weight: 800;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .sub {
    font-size: 0.85rem;
    color: var(--ink-3);
    margin-top: 2px;
  }
</style>
