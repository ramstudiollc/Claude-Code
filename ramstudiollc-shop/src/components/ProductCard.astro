---
import Icon from './Icon.astro';
import MockupArt from './MockupArt.astro';
import { categoryBySlug } from '../data/categories';
import { priceLabel, isNew, isFree, type Product } from '../lib/catalog';

interface Props {
  product: Product;
  size?: 'md' | 'lg';
  /** Eager-load the image (first cards on a page). */
  eager?: boolean;
}
const { product: p, size = 'md', eager = false } = Astro.props;
const cat = categoryBySlug(p.category);
const free = isFree(p);
const [cover, second] = p.images;
---

<article
  class:list={['card', `card-${size}`]}
  data-card
  data-category={p.category}
  data-formats={p.formats.join(',').toLowerCase()}
  data-price={p.price}
  data-free={free ? '1' : '0'}
  data-type={p.type}
  data-date={p.releasedAt ?? ''}
  data-title={p.title.toLowerCase()}
  data-search={`${p.title} ${p.tags.join(' ')} ${cat?.name ?? ''} ${p.useCases?.join(' ') ?? ''}`.toLowerCase()}
>
  <a href={`/mockups/${p.slug}/`} class="media" aria-label={p.title}>
    {cover ? (
      <>
        <img src={cover} alt={`${p.title} preview`} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1600" height="1067" class="img-a" />
        {second && <img src={second} alt="" loading="lazy" decoding="async" width="1600" height="1067" class="img-b" />}
      </>
    ) : (
      <MockupArt kind={p.art ?? 'box'} />
    )}
    <span class="badges">
      {free && <span class="badge badge-blue">Free</span>}
      {p.type === 'bundle' && <span class="badge badge-dark">Bundle</span>}
      {isNew(p, 45) && <span class="badge badge-sun">New</span>}
    </span>
    <span class="go" aria-hidden="true"><Icon name="arrow-up" size={18} /></span>
  </a>
  <div class="meta">
    <div class="row">
      <h3 class="title"><a href={`/mockups/${p.slug}/`}>{p.title}</a></h3>
      <span class="price">{priceLabel(p)}</span>
    </div>
    <div class="row sub">
      <span class="tag">{cat?.short}</span>
      {p.rating && p.rating.count > 0 ? (
        <span class="rating" aria-label={`Rated ${p.rating.value} out of 5 by ${p.rating.count} buyers`}>
          <Icon name="star" size={14} /> {p.rating.value.toFixed(1)} <span>({p.rating.count})</span>
        </span>
      ) : (
        <span class="fmt">{p.formats.join(' · ')}</span>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: 10px;
    box-shadow: var(--shadow-soft);
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-panel);
  }
  .media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface-2);
  }
  .card-lg .media {
    aspect-ratio: 16 / 11;
  }
  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out), opacity var(--t) var(--ease);
  }
  .img-b {
    opacity: 0;
  }
  .card:hover .img-a {
    transform: scale(1.05);
  }
  .card:hover .img-b {
    opacity: 1;
    transform: scale(1.05);
  }
  .badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 6px;
    z-index: 1;
  }
  .go {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(10px);
    color: var(--navy-900);
    opacity: 0;
    transform: translateY(8px) scale(0.9);
    transition: opacity var(--t) var(--ease), transform var(--t) var(--ease);
  }
  .card:hover .go {
    opacity: 1;
    transform: none;
  }
  .meta {
    padding: 14px 8px 6px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .title {
    font-family: var(--font-text);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .card-lg .title {
    font-size: 19px;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    color: var(--blue-500);
  }
  .price {
    font-weight: 700;
    font-size: 16px;
    white-space: nowrap;
  }
  .sub {
    margin-top: 8px;
    align-items: center;
  }
  .tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: var(--r-pill);
    background: #e7f0ff;
    color: var(--blue-600);
  }
  .rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-900);
  }
  .rating :global(svg) {
    color: #ffb400;
  }
  .rating span,
  .fmt {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-500);
  }
</style>
