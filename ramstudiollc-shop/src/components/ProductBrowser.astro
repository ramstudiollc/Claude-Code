---
// Library: search field + category chips + sort over a two-column grid of large cards.
// Every card is rendered at build time (good for search engines); the script only filters and re-orders.
import Icon from './Icon.astro';
import IconTile from './IconTile.astro';
import ProductCard from './ProductCard.astro';
import { library } from '../data/content';
import { activeCategories, type Product } from '../lib/catalog';

interface Props {
  items: Product[];
  /** Highlight this category chip; chips link to category pages. */
  current?: string;
}
const { items, current } = Astro.props;
---

<div class="browser" data-browser>
  <div class="tools">
    <label class="search" id="search">
      <Icon name="search" />
      <span class="visually-hidden">Search mockups</span>
      <input type="search" placeholder={library.searchPlaceholder} data-q autocomplete="off" />
    </label>
    <nav class="chips" aria-label="Categories">
      <a class="chip" href="/mockups/" aria-current={!current ? 'page' : undefined}><IconTile name="grid" tone="ink" size="sm" /> All</a>
      {activeCategories.map((c) => (
        <a class="chip" href={`/category/${c.slug}/`} aria-current={current === c.slug ? 'page' : undefined}>
          <IconTile name={c.icon} tone={c.tone} size="sm" /> {c.short} <span class="count">{c.count}</span>
        </a>
      ))}
      <a class="chip" href="/freebies/"><IconTile name="gift" tone="pink" size="sm" /> Free</a>
    </nav>
  </div>

  <div class="bar">
    <p class="count-line" aria-live="polite"><strong data-count>{items.length}</strong> mockups</p>
    <div class="right">
      <button class="chip plain" type="button" data-free aria-pressed="false"><Icon name="gift" size={16} /> Free only</button>
      <label class="sort">
        <span class="visually-hidden">Sort</span>
        <select data-sort>
          <option value="featured">Featured</option>
          <option value="new">Newest</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="az">Name A–Z</option>
        </select>
        <Icon name="chevron" size={16} />
      </label>
    </div>
  </div>

  <div class="grid" data-grid data-stagger>
    {items.map((p, i) => <ProductCard product={p} size="lg" eager={i < 2} />)}
  </div>
  <p class="empty muted" data-empty hidden>{library.empty}</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-browser]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-card]')];
    const original = [...cards];
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const freeBtn = root.querySelector<HTMLButtonElement>('[data-free]')!;
    const params = new URLSearchParams(location.search);
    if (params.get('q')) q.value = params.get('q')!;
    if (location.hash === '#search') q.focus();

    function apply() {
      const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const freeOnly = freeBtn.getAttribute('aria-pressed') === 'true';
      let shown = 0;
      for (const c of cards) {
        const d = c.dataset;
        const ok = terms.every((t) => d.search!.includes(t)) && (!freeOnly || d.free === '1');
        (c.parentElement === grid ? c : c).hidden = !ok;
        if (ok) shown++;
      }
      root!.querySelector('[data-count]')!.textContent = String(shown);
      root!.querySelector<HTMLElement>('[data-empty]')!.hidden = shown > 0;
      const by = sort.value;
      const list = by === 'featured' ? original : [...cards].sort((a, b) => {
        const A = a.dataset, B = b.dataset;
        if (by === 'price-asc') return +A.price! - +B.price!;
        if (by === 'price-desc') return +B.price! - +A.price!;
        if (by === 'az') return A.title!.localeCompare(B.title!);
        return (B.date ?? '').localeCompare(A.date ?? '');
      });
      grid.append(...list);
    }
    freeBtn.addEventListener('click', () => {
      freeBtn.setAttribute('aria-pressed', String(freeBtn.getAttribute('aria-pressed') !== 'true'));
      apply();
    });
    q.addEventListener('input', apply);
    sort.addEventListener('change', apply);
    apply();
  }
</script>

<style>
  .tools {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(100%, 600px);
    height: 60px;
    padding: 0 24px;
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: var(--shadow-md), 0 0 0 1px var(--line);
    color: var(--muted);
    transition: box-shadow var(--t-fast);
  }
  .search:focus-within {
    box-shadow: var(--shadow-md), 0 0 0 2px var(--blue);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font: inherit;
    font-size: 17px;
    color: var(--ink);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .right {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .sort {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .sort select {
    appearance: none;
    height: 40px;
    padding: 0 40px 0 16px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }
  .sort :global(svg) {
    position: absolute;
    right: 14px;
    pointer-events: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .empty {
    padding: 48px 0;
    text-align: center;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 889px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .chips {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      width: 100%;
      padding-bottom: 6px;
      scrollbar-width: none;
    }
  }
</style>
