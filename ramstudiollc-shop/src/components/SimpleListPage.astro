---
// Shared shell for short listing pages (freebies, bundles).
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import ProductCard from './ProductCard.astro';
import Button from './Button.astro';
import type { Product } from '../lib/catalog';

interface Props {
  seo: { title: string; description: string };
  eyebrow: string;
  title: string;
  sub: string;
  items: Product[];
  emptyText: string;
}
const { seo, eyebrow, title, sub, items, emptyText } = Astro.props;
---

<Base title={seo.title} description={seo.description}>
  <PageHero eyebrow={eyebrow} title={title} sub={sub} />
  <section class="section-tight">
    <div class="wrap">
      {items.length > 0 ? (
        <div class="grid-cards" data-stagger>{items.map((p, i) => <ProductCard product={p} eager={i < 3} />)}</div>
      ) : (
        <div class="empty">
          <p class="lead">{emptyText}</p>
          <Button href="/mockups/">Browse all mockups</Button>
        </div>
      )}
      <slot />
    </div>
  </section>
</Base>

<style>
  .empty {
    display: grid;
    justify-items: center;
    gap: 24px;
    text-align: center;
    padding: 40px 0;
  }
</style>
