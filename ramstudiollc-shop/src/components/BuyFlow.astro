---
// "How buying works" — explains the Gumroad hand-off so leaving the site never surprises anyone.
import Icon from './Icon.astro';
import { home } from '../data/content';
const f = home.flow;
---

<section class="section">
  <div class="wrap">
    <div class="head center">
      <p class="eyebrow" data-reveal>{f.eyebrow}</p>
      <h2 class="h2" data-reveal>{f.title}</h2>
    </div>
    <ol class="steps" data-stagger>
      {f.steps.map((s, i) => (
        <li class="step">
          <span class="num">0{i + 1}</span>
          <span class="ico"><Icon name={s.icon} size={24} /></span>
          <h3 class="h3">{s.title}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    counter-reset: step;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .step:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-panel);
  }
  .num {
    position: absolute;
    top: 24px;
    right: 28px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 44px;
    letter-spacing: -0.05em;
    color: var(--surface-2);
  }
  .ico {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--blue-500);
    color: #fff;
  }
  @media (max-width: 889px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
