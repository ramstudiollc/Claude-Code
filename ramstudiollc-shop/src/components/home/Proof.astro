---
// Social proof from real Gumroad ratings only — no invented testimonials.
import Icon from '../Icon.astro';
import { home } from '../../data/content';
import { products, stats, fill } from '../../lib/catalog';
const pr = home.proof;
const rated = products.filter((p) => p.rating && p.rating.count > 0).sort((a, b) => b.rating!.count - a.rating!.count);
---

{stats.reviews > 0 && (
  <section class="section">
    <div class="wrap grid">
      <div class="score panel" data-reveal>
        <p class="eyebrow">{pr.eyebrow}</p>
        <p class="big">{stats.rating}</p>
        <p class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={26} />)}</p>
        <h2 class="h3">{fill(pr.title)}</h2>
        <p class="muted">{fill(pr.sub)}</p>
      </div>
      <ul class="list" data-stagger>
        {rated.map((p) => (
          <li>
            <a href={`/mockups/${p.slug}/`} class="item">
              {p.images[0] && <img src={p.images[0]} alt="" loading="lazy" width="160" height="107" />}
              <span class="name">{p.title}</span>
              <span class="r"><Icon name="star" size={16} /> {p.rating!.value.toFixed(1)} <small>({p.rating!.count})</small></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 24px;
    align-items: start;
  }
  .score {
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(96px, 11vw, 160px);
    line-height: 0.85;
    letter-spacing: -0.06em;
  }
  .stars {
    display: flex;
    gap: 4px;
    color: #ffb400;
    margin-bottom: 8px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 10px 18px 10px 10px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .item:hover {
    transform: translateX(6px);
    box-shadow: var(--shadow-panel);
  }
  .item img {
    width: 80px;
    height: 56px;
    object-fit: cover;
    border-radius: 12px;
  }
  .name {
    font-weight: 600;
    font-size: 16px;
  }
  .r {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
  }
  .r :global(svg) {
    color: #ffb400;
  }
  .r small {
    font-weight: 500;
    color: var(--ink-500);
  }
  @media (max-width: 889px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .item {
      grid-template-columns: 64px 1fr auto;
    }
    .item img {
      width: 64px;
      height: 46px;
    }
    .name {
      font-size: 15px;
    }
  }
</style>
