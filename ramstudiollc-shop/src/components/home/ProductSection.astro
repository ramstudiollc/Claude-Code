---
import Button from '../Button.astro';
import Heading from '../Heading.astro';
import ProductCard from '../ProductCard.astro';
import type { Product } from '../../lib/catalog';

interface Props {
  eyebrow: string;
  title: string | string[];
  sub?: string;
  cta?: { label: string; href: string };
  items: Product[];
  icon?: string;
}
const { eyebrow, title, sub, cta, items, icon = 'spark' } = Astro.props;
---

{items.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="head">
        <Heading eyebrow={eyebrow} icon={icon} title={title} sub={sub} />
        {cta && <div data-reveal><Button href={cta.href} variant="ghost" icon="grid">{cta.label}</Button></div>}
      </div>
      <div class="grid-cards" data-stagger>
        {items.map((p, i) => <ProductCard product={p} eager={i < 3} />)}
      </div>
    </div>
  </section>
)}
