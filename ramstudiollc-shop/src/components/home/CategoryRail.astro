---
import Icon from '../Icon.astro';
import MockupArt from '../MockupArt.astro';
import { home } from '../../data/content';
import { activeCategories } from '../../lib/catalog';
const c = home.categories;
---

<section class="section">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow" data-reveal>{c.eyebrow}</p>
        <h2 class="h2" data-reveal>{c.title}</h2>
        <p class="lead" data-reveal>{c.sub}</p>
      </div>
    </div>
    <div class="rail" data-stagger>
      {activeCategories.map((cat) => (
        <a class="cat" href={`/category/${cat.slug}/`}>
          <div class="img">
            {cat.cover ? <img src={cat.cover} alt="" loading="lazy" width="800" height="600" /> : <MockupArt kind={cat.art} />}
          </div>
          <div class="info">
            <span class="ico"><Icon name={cat.icon} size={20} /></span>
            <span class="txt">
              <strong>{cat.name}</strong>
              <small>{cat.count} {cat.count === 1 ? 'mockup' : 'mockups'} · {cat.blurb}</small>
            </span>
            <span class="arrow"><Icon name="arrow" size={18} /></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .rail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }
  .cat {
    position: relative;
    display: block;
    border-radius: var(--r-lg);
    overflow: hidden;
    text-decoration: none;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .cat:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-panel);
  }
  .img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }
  .cat:hover .img img {
    transform: scale(1.06);
  }
  .info {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
  }
  .ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #e7f0ff;
    color: var(--blue-500);
  }
  .txt {
    flex: 1;
    min-width: 0;
  }
  .txt strong {
    display: block;
    font-size: 18px;
    font-weight: 600;
  }
  .txt small {
    display: block;
    font-size: 14px;
    color: var(--ink-500);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: background var(--t-fast), color var(--t-fast), transform var(--t) var(--ease);
  }
  .cat:hover .arrow {
    background: var(--navy-900);
    color: #fff;
    transform: rotate(-45deg);
  }
</style>
