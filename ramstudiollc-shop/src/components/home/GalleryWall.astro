---
import Button from '../Button.astro';
import { home } from '../../data/content';
import { allImages, fill } from '../../lib/catalog';
const w = home.wall;
// Five columns of real preview images; neighbouring columns travel in opposite directions on scroll.
const cols = [0, 1, 2, 3, 4].map((c) => allImages.filter((_, i) => i % 5 === c).slice(0, 7));
const speeds = [0.5, -0.35, 0.65, -0.45, 0.4];
---

{allImages.length > 0 && (
  <section class="wall">
    <div class="cols" aria-hidden="true">
      {cols.map((col, i) => (
        <div class="col">
          <div class="track" data-speed={speeds[i]}>
            {col.map((img) => <img src={img.src} alt="" loading="lazy" width="600" height="400" />)}
          </div>
        </div>
      ))}
    </div>
    <div class="center">
      <p class="eyebrow" data-reveal>{w.eyebrow}</p>
      <p class="count" data-reveal="zoom">{fill(w.count)}</p>
      <p class="label" data-reveal>{w.label}</p>
      <div data-reveal><Button href={w.cta.href}>{w.cta.label}</Button></div>
    </div>
  </section>
)}

<style>
  .wall {
    position: relative;
    height: clamp(640px, 95vh, 980px);
    overflow: hidden;
    margin-block: var(--section);
  }
  .cols {
    position: absolute;
    inset: -10% -6%;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
    transform: rotate(-6deg);
    mask-image: radial-gradient(70% 60% at 50% 50%, transparent 18%, #000 62%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 50%, transparent 18%, #000 62%);
  }
  .track {
    display: grid;
    gap: 18px;
    will-change: transform;
  }
  .track img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: var(--shadow-soft);
  }
  .center::before {
    content: '';
    position: absolute;
    inset: 12% 18%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--page) 55%, rgb(244 246 251 / 0.85) 75%, transparent);
  }
  .center {
    position: relative;
    z-index: 1;
    isolation: isolate;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: var(--gutter);
  }
  .count {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(110px, 17vw, 240px);
    line-height: 0.82;
    letter-spacing: -0.06em;
    background: linear-gradient(180deg, var(--navy-900), var(--blue-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .label {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    font-size: clamp(22px, 2.6vw, 36px);
    margin: 12px 0 28px;
  }
  @media (max-width: 889px) {
    .cols {
      grid-template-columns: repeat(3, 1fr);
    }
    .col:nth-child(n + 4) {
      display: none;
    }
  }
</style>
