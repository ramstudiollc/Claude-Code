---
// Social proof from real Gumroad ratings only — never invented quotes.
import Heading from '../Heading.astro';
import Icon from '../Icon.astro';
import IconTile from '../IconTile.astro';
import { home } from '../../data/content';
import { categoryBySlug } from '../../data/categories';
import { products, stats } from '../../lib/catalog';
const r = home.reviews;
const rated = products.filter((p) => p.rating && p.rating.count > 0).sort((a, b) => b.rating!.count - a.rating!.count);
---

{rated.length > 0 && (
  <section class="section reviews" data-carousel>
    <div class="wrap">
      <div class="head">
        <Heading eyebrow={r.eyebrow} icon="star" title={r.title} sub={r.sub} />
        <div class="controls" data-reveal>
          <button class="icon-btn" type="button" aria-label="Previous" data-prev><Icon name="arrow-left" /></button>
          <button class="icon-btn" type="button" aria-label="Next" data-next><Icon name="arrow" /></button>
        </div>
      </div>
    </div>
    <div class="track" data-track tabindex="0" aria-label="Rated mockups">
      <article class="summary card" data-reveal>
        <IconTile name="star" tone="sun" size="lg" />
        <p class="score"><span class="grad">{stats.rating}</span><small>/5</small></p>
        <p class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={18} />)}</p>
        <p class="muted">{stats.reviews} verified ratings on Gumroad</p>
      </article>
      {rated.map((p, i) => {
        const cat = categoryBySlug(p.category);
        return (
          <a class="rev card" href={`/mockups/${p.slug}/`} data-reveal style={`--i:${(i + 1) % 6}`}>
            <div class="top">
              <p class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}</p>
              <span class="badge">{cat?.short}</span>
            </div>
            <p class="quote">
              <strong>{p.rating!.value.toFixed(1)}</strong> average from {p.rating!.count} verified {p.rating!.count === 1 ? 'buyer' : 'buyers'}
            </p>
            <div class="who">
              {p.images[0] && <img src={p.images[0]} alt="" loading="lazy" width="120" height="80" />}
              <span>
                <strong>{p.title}</strong>
                <small>Gumroad · verified purchase</small>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const step = () => ((track.children[1] as HTMLElement)?.offsetWidth ?? 340) + 20;
    root.querySelector('[data-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('[data-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

<style>
  .reviews .head {
    align-items: flex-end;
  }
  .controls {
    display: flex;
    gap: 10px;
  }
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(380px, 84vw);
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2));
    padding: 10px max(var(--gutter), calc((100vw - var(--wrap)) / 2)) 40px;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .card {
    scroll-snap-align: start;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .summary {
    background: radial-gradient(120% 90% at 100% 0%, #fff1e3, transparent 60%), radial-gradient(100% 90% at 0% 100%, #ece7ff, transparent 60%), #fff;
  }
  .score {
    font-size: 88px;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
    margin-top: auto;
  }
  .score small {
    font-size: 28px;
    color: var(--soft);
    letter-spacing: -0.02em;
  }
  .stars {
    display: flex;
    gap: 3px;
    color: var(--sun);
  }
  .rev {
    text-decoration: none;
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .rev:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .quote {
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
    flex: 1;
  }
  .quote strong {
    font-weight: 500;
    background: var(--aurora);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .who {
    display: flex;
    gap: 12px;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .who img {
    width: 56px;
    height: 40px;
    object-fit: cover;
    border-radius: 10px;
  }
  .who strong {
    display: block;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
  .who small {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
</style>
