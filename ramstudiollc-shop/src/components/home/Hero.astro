---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home } from '../../data/content';
import { products, stats, fill } from '../../lib/catalog';

const h = home.hero;
const withImages = products.filter((p) => p.images.length);
const pill = withImages.find((p) => p.featured)?.images[0] ?? withImages[0]?.images[0];
// Three columns of real preview images that drift with scroll.
const pool: { src: string }[] = [];
for (let k = 0; k < 3; k++) for (const p of withImages) if (p.images[k]) pool.push({ src: p.images[k] });
const cols = [0, 1, 2].map((c) => pool.filter((_, i) => i % 3 === c).slice(0, 6));
---

<section class="hero dark-band grain on-dark">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow intro" style="--d:0">{h.eyebrow}</p>
      <h1 class="display headline">
        {h.lines.map((line, i) => (
          <span class="line">
            <span class="intro" style={`--d:${i + 1}`}>
              {line}
              {i === h.pillAfterLine && pill && <img class="pill" src={pill} alt="" width="220" height="110" />}
            </span>
          </span>
        ))}
      </h1>
      <p class="lead intro" style="--d:4">{h.sub}</p>
      <div class="ctas intro" style="--d:5">
        <Button href={h.primary.href} variant="blue">{fill(h.primary.label)}</Button>
        <Button href={h.secondary.href} variant="glass">{h.secondary.label}</Button>
      </div>
      <ul class="chips intro" style="--d:6">
        {h.chips.map((c) => <li><Icon name="check" size={16} /> {c}</li>)}
      </ul>
    </div>

    <div class="stage" aria-hidden="true">
      <div class="tilt">
        {cols.map((col, i) => (
          <div class="col">
            <div class="track" data-speed={[0.35, -0.3, 0.45][i]}>
              {col.map((img) => <img src={img.src} alt="" loading="eager" width="400" height="267" />)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap">
    <dl class="stats intro" style="--d:7">
      <div><dt>Mockups</dt><dd>{stats.products}</dd></div>
      <div><dt>Free samples</dt><dd>{stats.free}</dd></div>
      <div><dt>Preview scenes</dt><dd>{stats.images}</dd></div>
      {stats.reviews > 0 && <div><dt>Gumroad rating</dt><dd>{stats.rating}<Icon name="star" size={22} /></dd></div>}
    </dl>
  </div>
</section>

<style>
  .hero {
    min-height: max(100vh, 820px);
    padding-top: 160px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .glow {
    position: absolute;
    inset: -20% -10% auto 20%;
    height: 120%;
    z-index: -1;
    background: radial-gradient(40% 45% at 55% 35%, rgb(47 128 255 / 0.75), transparent 70%), radial-gradient(30% 35% at 80% 55%, rgb(91 59 255 / 0.55), transparent 70%);
    filter: blur(20px);
    animation: breathe 9s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    to {
      transform: translate3d(-4%, 3%, 0) scale(1.08);
      opacity: 0.85;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
  }
  .headline {
    margin-bottom: 28px;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .line > span {
    display: inline-flex;
    align-items: center;
    gap: 0.18em;
  }
  .pill {
    height: 0.82em;
    width: 1.9em;
    object-fit: cover;
    border-radius: var(--r-pill);
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.18);
  }
  .lead {
    max-width: 30em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 15px;
    color: #c9d3f0;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .chips :global(svg) {
    color: #8db8ff;
  }

  /* load intro: each piece rises in sequence */
  .intro {
    animation: rise 1s var(--ease-out) both;
    animation-delay: calc(var(--d, 0) * 90ms + 150ms);
  }
  .line > .intro {
    animation-name: rise-line;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }
  @keyframes rise-line {
    from {
      transform: translateY(105%);
    }
  }

  .stage {
    position: relative;
    height: 620px;
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
  }
  .tilt {
    position: absolute;
    inset: -10% -30% -10% 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    transform: rotate(-8deg) skewX(-4deg);
  }
  .col {
    overflow: visible;
  }
  .track {
    display: grid;
    gap: 16px;
    will-change: transform;
  }
  .track img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.6), 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .stats {
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: var(--r-lg);
    border: 1px solid var(--line-dark);
    background: var(--glass-dark);
    backdrop-filter: blur(14px);
  }
  .stats div {
    padding: 18px 24px;
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }
  .stats div + div {
    border-left: 1px solid var(--line-dark);
  }
  .stats dt {
    font-size: 13px;
    color: #9aa6c9;
  }
  .stats dd {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    letter-spacing: -0.03em;
  }
  .stats dd :global(svg) {
    color: #ffb400;
  }

  @media (max-width: 1199px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .stage {
      height: 360px;
      order: -1;
      margin-bottom: -40px;
    }
    .hero {
      padding-top: 130px;
    }
  }
  @media (max-width: 889px) {
    .hero {
      min-height: auto;
      padding-top: 120px;
    }
    .stage {
      height: 260px;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats div:nth-child(3) {
      border-left: 0;
    }
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--line-dark);
    }
    .stats dd {
      font-size: 26px;
    }
  }
</style>
