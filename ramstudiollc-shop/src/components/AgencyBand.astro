---
// Cross-sell to the agency. Prices are the published "from" prices on ramstudiollc.com.
import { site } from '../config/site';
const offers = [
  { name: 'Custom e-commerce mockup', price: 'from $100' },
  { name: 'Packaging & label design', price: 'from $250' },
  { name: '3D product visualisation', price: 'from $400' },
];
---

<section class="section">
  <div class="wrap band">
    <div>
      <p class="eyebrow">Need something made for you?</p>
      <h2>Custom packaging and mockups from RAM Studio</h2>
      <p class="muted">
        The studio behind this shop designs packaging, labels and 3D product renders for brands. Every project includes{' '}
        <strong>100% commercial rights</strong> and print-ready source files.
      </p>
    </div>
    <div class="side">
      <ul>
        {offers.map((o) => (
          <li>
            <span>{o.name}</span>
            <strong>{o.price}</strong>
          </li>
        ))}
      </ul>
      <a href={site.agency.url} class="btn btn-primary" rel="noopener">Start a custom project</a>
    </div>
  </div>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }
  .muted {
    margin-top: 14px;
    max-width: 52ch;
  }
  .side {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: 24px;
    display: grid;
    gap: 18px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 0;
  }
  @media (max-width: 820px) {
    .band {
      grid-template-columns: 1fr;
    }
  }
</style>
