---
// Cross-sell to the agency. Prices are the published "from" prices on ramstudiollc.com.
import Button from './Button.astro';
import { home } from '../data/content';
const a = home.agency;
---

<section class="section">
  <div class="wrap grid">
    <div>
      <p class="eyebrow" data-reveal>{a.eyebrow}</p>
      <h2 class="h2" data-reveal>{a.title}</h2>
      <p class="lead" data-reveal>{a.sub}</p>
    </div>
    <div class="panel side" data-reveal>
      <ul>
        {a.offers.map((o) => (
          <li>
            <span>{o.name}</span>
            <strong>{o.price}</strong>
          </li>
        ))}
      </ul>
      <Button href={a.cta.href} block>{a.cta.label}</Button>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .lead {
    margin-top: 18px;
  }
  .side {
    padding: 28px;
    display: grid;
    gap: 22px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 0;
  }
  strong {
    white-space: nowrap;
  }
  @media (max-width: 889px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
